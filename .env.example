# Optional. If set, /api/cron/* requires Authorization: Bearer $CRON_SECRET.
# Vercel Cron sends this automatically when CRON_SECRET is set on the project.
CRON_SECRET=

# One of these unlocks scripts/fetch-quote.mjs. Neither is required to build the site.
# The site does not scrape Yahoo, Nasdaq, or Stooq.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional. Reserved for a future Copernicus Data Space Ecosystem download.
# Scene search works without them. Pixel download from CDSE needs a registered account.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
